---
import siteData from '@/data/site.json';
const { hero } = siteData;
---

<section id="top" class="relative min-h-screen flex flex-col pt-32 md:pt-40 pb-12 overflow-hidden">
  {/* Grid */}
  <div class="absolute inset-0 pointer-events-none opacity-[0.03]" aria-hidden="true">
    <div class="h-full w-full" style="background-image: linear-gradient(to right, #0A0A0A 1px, transparent 1px), linear-gradient(to bottom, #0A0A0A 1px, transparent 1px); background-size: 80px 80px;"></div>
  </div>

  <div class="container-wide relative z-10 flex-1 flex flex-col justify-between">
    {/* Top meta */}
    <div class="flex flex-wrap items-center justify-between gap-4 reveal-up">
      <div class="flex items-center gap-3 text-xs text-ink-muted font-mono">
        <span class="w-2 h-2 rounded-full bg-ink animate-pulse-soft"></span>
        <span class="uppercase tracking-widest">{hero.availability}</span>
      </div>
      <div class="text-xs text-ink-muted font-mono uppercase tracking-widest">
        {hero.location}
      </div>
    </div>

    {/* HUGE NAME — fills viewport */}
    <div class="flex-1 flex flex-col justify-center py-12 md:py-20">
      <h1 class="font-sans font-black uppercase leading-[0.82] tracking-[-0.045em]"
          style="font-size: clamp(4.5rem, 19vw, 24rem)">
        <span class="split-line block">
          <span class="split-line-inner">Veta</span>
        </span>
        <span class="split-line block">
          <span class="split-line-inner" style="transition-delay: 0.15s">Sergeeva<span class="opacity-20">.</span></span>
        </span>
      </h1>

      {/* Small intro under giant name */}
      <div class="mt-10 md:mt-16 grid grid-cols-1 md:grid-cols-12 gap-6 reveal-up" style="transition-delay: 0.4s">
        <div class="md:col-span-5 md:col-start-8">
          <div class="flex items-center gap-3 flex-wrap mb-5">
            {hero.tagline.split('·').map((word: string) => (
              <span class="pill text-xs uppercase tracking-widest">{word.trim()}</span>
            ))}
          </div>
          <p class="text-sm text-ink-muted leading-relaxed">
            {hero.intro}
          </p>
        </div>
      </div>
    </div>

    {/* Scroll indicator */}
    <div class="flex items-end justify-between gap-8">
      <a href="#showcase" class="group inline-flex items-center gap-4 text-xs uppercase tracking-widest font-medium">
        <span class="w-14 h-14 md:w-16 md:h-16 rounded-full bg-ink text-bg flex items-center justify-center group-hover:scale-110 transition-transform duration-500">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="group-hover:translate-y-1 transition-transform duration-500">
            <path d="M8 2V14M8 14L3 9M8 14L13 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span>Листать</span>
      </a>
      <div class="hidden md:block text-right text-xs font-mono text-ink-muted uppercase tracking-widest">
        <div>Scroll ↓</div>
      </div>
    </div>
  </div>
</section>
