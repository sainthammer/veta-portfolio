---
import siteData from '@/data/site.json';
const { hero } = siteData;
const sourcePhotos = (hero as any).showcasePhotos?.length
  ? (hero as any).showcasePhotos
  : hero.photos;
---

<section id="showcase" class="relative py-12 md:py-20 border-y border-ink/10 overflow-hidden bg-bg-secondary">
  <div class="marquee-fade">
    <div class="photo-marquee-outer">
      {[0, 1].map((copy) => (
        <div class="photo-marquee-inner" aria-hidden={copy === 1 ? 'true' : undefined}>
          {sourcePhotos.map((photo: any, idx: number) => (
            <div class="shrink-0 aspect-[3/4] w-[60vw] md:w-[30vw] lg:w-[22vw] relative overflow-hidden rounded-sm group mx-3 md:mx-5">
              <img
                src={photo.src}
                alt={photo.alt}
                loading={copy === 0 && idx < 3 ? 'eager' : 'lazy'}
                class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-ink/20 to-transparent pointer-events-none"></div>
              {photo.caption && (
                <div class="absolute bottom-4 left-4 right-4">
                  <span class="pill bg-bg/90 backdrop-blur-sm text-[10px] uppercase tracking-widest">
                    {photo.caption}
                  </span>
                </div>
              )}
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .photo-marquee-outer {
    display: flex;
    width: max-content;
  }

  .photo-marquee-inner {
    display: flex;
    flex-shrink: 0;
    animation: photo-marquee 30s linear infinite;
  }

  @media (max-width: 767px) {
    .photo-marquee-inner {
      animation-duration: 18s;
    }
  }

  @keyframes photo-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-100%); }
  }
</style>