---
import siteData from '@/data/site.json';
const { hero } = siteData;
// duplicate for seamless loop
const photos = [...hero.photos, ...hero.photos];
---

<section id="showcase" class="relative py-12 md:py-20 border-y border-ink/10 overflow-hidden bg-bg-secondary">
  <div class="marquee-fade">
    <div class="flex animate-marquee gap-6 md:gap-10 w-max">
      {photos.map((photo: any, idx: number) => (
        <div class="shrink-0 aspect-[3/4] w-[60vw] md:w-[30vw] lg:w-[22vw] relative overflow-hidden rounded-sm group">
          <img
            src={photo.src}
            alt={photo.alt}
            loading={idx < 3 ? 'eager' : 'lazy'}
            class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink/20 to-transparent pointer-events-none"></div>
          {photo.caption && (
            <div class="absolute bottom-4 left-4 right-4">
              <span class="pill bg-bg/90 backdrop-blur-sm text-[10px] uppercase tracking-widest">
                {}
              </span>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
