---
interface Props {
  words?: string[];
  speed?: number;
  speedMobile?: number;
}

const {
  words = ['Reels', 'Stories', 'SMM', 'Content', 'Strategy', 'Viral', 'Instagram', 'TikTok'],
  speed = 60,
  speedMobile = 80,
} = Astro.props;
---

<section class="py-12 md:py-20 border-y border-ink/10 overflow-hidden">
  <div class="marquee">
    <div
      class="marquee-track"
      data-speed={speed}
      data-speed-mobile={speedMobile}
    >
      {[0, 1, 2, 3].map((copy) => (
        <ul class="marquee-list" aria-hidden={copy > 0 ? 'true' : undefined}>
          {words.map((word) => (
            <li class="marquee-item">
              <span class="marquee-word font-display italic text-5xl md:text-8xl text-ink">
                {word}
              </span>
              <span class="marquee-dot w-2.5 h-2.5 md:w-3.5 md:h-3.5 rounded-full bg-accent"></span>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>

<style>
  .marquee {
    display: flex;
    overflow: hidden;
  }

  .marquee-track {
    display: flex;
    flex-shrink: 0;
    width: max-content;
    will-change: transform;
    transform: translate3d(0, 0, 0);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .marquee-list {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .marquee-item {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: 1.5rem;
    padding-right: 1.5rem;
  }

  @media (min-width: 768px) {
    .marquee-item {
      gap: 2.5rem;
      padding-right: 2.5rem;
    }
  }

  .marquee-word {
    white-space: nowrap;
  }
</style>

<script>
  function initMarquee() {
    const tracks = document.querySelectorAll<HTMLElement>('.marquee-track');

    tracks.forEach((track) => {
      const firstList = track.querySelector<HTMLElement>('.marquee-list');
      if (!firstList) return;

      const speedDesktop = Number(track.dataset.speed) || 60;
      const speedMobile = Number(track.dataset.speedMobile) || 80;

      let offset = 0;
      let lastTime = performance.now();
      let singleCopyWidth = firstList.offsetWidth;
      let rafId: number;
      let paused = false;

      // Пересчёт ширины одной копии (после загрузки шрифтов и ресайзов)
      const updateWidth = () => {
        singleCopyWidth = firstList.offsetWidth;
      };

      // Пересчитываем когда шрифты догрузились
      if (document.fonts) {
        document.fonts.ready.then(updateWidth);
      }

      // И при изменении размера окна
      const resizeObserver = new ResizeObserver(updateWidth);
      resizeObserver.observe(firstList);

      const getSpeed = () =>
        window.matchMedia('(max-width: 767px)').matches ? speedMobile : speedDesktop;

      const tick = (now: number) => {
        if (paused) {
          lastTime = now;
          rafId = requestAnimationFrame(tick);
          return;
        }

        const delta = (now - lastTime) / 1000;
        lastTime = now;

        offset += getSpeed() * delta;

        // Мгновенный сброс на ширину одной копии — визуально неотличимо
        if (offset >= singleCopyWidth) {
          offset -= singleCopyWidth;
        }

        track.style.transform = `translate3d(${-offset}px, 0, 0)`;
        rafId = requestAnimationFrame(tick);
      };

      rafId = requestAnimationFrame(tick);

      // Пауза, когда вкладка неактивна (иначе delta будет огромным)
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          paused = true;
        } else {
          paused = false;
          lastTime = performance.now();
        }
      });

      // Уважение к reduced motion
      const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (motionQuery.matches) {
        cancelAnimationFrame(rafId);
      }
    });
  }

  // Запуск при загрузке + для Astro View Transitions
  initMarquee();
  document.addEventListener('astro:page-load', initMarquee);
</script>