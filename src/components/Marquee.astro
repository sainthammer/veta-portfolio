---
interface Props {
  words?: string[];
  duration?: number;
  durationMobile?: number;
}

const {
  words = ['Reels', 'Stories', 'SMM', 'Content', 'Strategy', 'Viral', 'Instagram', 'TikTok'],
  duration = 20,
  durationMobile = 27,
} = Astro.props;
---

<section class="py-12 md:py-20 border-y border-ink/10 overflow-hidden">
  <div class="marquee-fade">
    <div class="marquee-outer">
      {[0, 1].map((copy) => (
        <div class="marquee-inner" aria-hidden={copy === 1 ? 'true' : undefined}>
          {words.map((word) => (
            <>
              <span class="marquee-word font-display italic text-5xl md:text-8xl text-ink">{word}</span>
              <span class="marquee-dot w-2.5 h-2.5 md:w-3.5 md:h-3.5 rounded-full bg-accent shrink-0"></span>
            </>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style define:vars={{ duration: `${duration}s`, durationMobile: `${durationMobile}s` }}>
  .marquee-outer {
    display: flex;
    width: max-content;
  }

  .marquee-inner {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    animation: marquee var(--duration) linear infinite;
  }

  @media (max-width: 767px) {
    .marquee-inner {
      animation-duration: var(--durationMobile);
    }
  }

  /* Одинаковые отступы у каждого элемента — слева и справа */
  .marquee-word {
    padding: 0 1.5rem;
  }

  .marquee-dot {
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    .marquee-word {
      padding: 0 2.5rem;
    }
  }

  @keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-100%); }
  }
</style>