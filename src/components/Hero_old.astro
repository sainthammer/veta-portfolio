---
import siteData from '@/data/site.json';

const { hero } = siteData;
const [firstName, lastName] = hero.name.split(' ');
---

<section id="top" class="relative min-h-screen flex flex-col justify-between pt-32 md:pt-40 pb-12 overflow-hidden">
  {/* Decorative grid */}
  <div class="absolute inset-0 pointer-events-none opacity-[0.04]" aria-hidden="true">
    <div class="h-full w-full" style="background-image: linear-gradient(to right, #0A0A0A 1px, transparent 1px), linear-gradient(to bottom, #0A0A0A 1px, transparent 1px); background-size: 80px 80px;"></div>
  </div>

  {/* Floating orb accent */}
  <div class="absolute top-1/3 right-[10%] w-72 h-72 md:w-96 md:h-96 rounded-full bg-accent/30 blur-3xl animate-float pointer-events-none" aria-hidden="true"></div>
  <div class="absolute bottom-[15%] left-[5%] w-60 h-60 rounded-full bg-accent-soft blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="container-wide relative z-10">
    {/* Top meta line */}
    <div class="flex flex-wrap items-center justify-between gap-4 mb-12 md:mb-20 reveal-up">
      <div class="flex items-center gap-3 text-sm text-ink-muted font-mono">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse-soft"></span>
        <span class="uppercase tracking-widest">{hero.availability}</span>
      </div>
      <div class="text-sm text-ink-muted font-mono uppercase tracking-widest">
        {hero.location}
      </div>
    </div>

    {/* Mega name typography */}
    <h1 class="font-display font-light leading-[0.85] tracking-[-0.04em]">
      <span class="split-line block"><span class="split-line-inner italic font-normal">{firstName}</span></span>
      <span class="split-line block -mt-2 md:-mt-4"><span class="split-line-inner font-light" style="transition-delay: 0.15s">{lastName}<span class="text-accent">.</span></span></span>
    </h1>

    {/* Tagline */}
    <div class="mt-8 md:mt-12 flex flex-col md:flex-row md:items-end md:justify-between gap-8 reveal-up" style="transition-delay: 0.4s">
      <div class="max-w-md">
        <p class="text-base md:text-lg text-ink-soft leading-relaxed">
          {hero.intro}
        </p>
      </div>
      <div class="flex items-center gap-3 flex-wrap">
        {hero.tagline.split('·').map((word: string) => (
          <span class="pill bg-bg/50 backdrop-blur-sm">{word.trim()}</span>
        ))}
      </div>
    </div>
  </div>

  {/* Bottom scroll indicator */}
  <div class="container-wide relative z-10 mt-20 md:mt-32">
    <div class="flex items-end justify-between gap-8">
      <a href="#work" class="group inline-flex items-center gap-4 text-sm uppercase tracking-widest font-medium">
        <span class="w-16 h-16 rounded-full bg-ink text-bg flex items-center justify-center group-hover:bg-accent transition-colors duration-500">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" class="group-hover:translate-y-1 transition-transform duration-500">
            <path d="M8 2V14M8 14L3 9M8 14L13 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span>Смотреть работы</span>
      </a>

      <div class="hidden md:block text-right text-xs font-mono text-ink-muted uppercase tracking-widest">
        <div>Scroll</div>
        <div class="mt-1">↓ ↓ ↓</div>
      </div>
    </div>
  </div>
</section>
