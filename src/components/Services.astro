---
import siteData from '@/data/site.json';
const { services } = siteData;
---

<section id="services" class="relative py-24 md:py-40 bg-ink text-bg overflow-hidden">
  <div class="container-wide relative z-10">

    {/* Oversized title */}
    <div class="mb-4 md:mb-6 reveal-up overflow-hidden">
      <h2 class="font-sans font-black uppercase leading-none tracking-tighter"
          style="font-size: clamp(3.5rem, 11vw, 11rem)">
        Services
      </h2>
    </div>

    <p class="text-xs font-mono uppercase tracking-widest text-bg/40 mb-16 md:mb-24 reveal-up max-w-xs" style="transition-delay:0.1s">
      — 02 / От одного Reel до полного ведения соцсетей
    </p>

    <div class="space-y-0">
      {services.map((service: any) => (
        <div class="group relative border-t border-bg/10 py-8 md:py-10 cursor-pointer overflow-hidden" data-cursor-hover>
          <div class="absolute inset-0 bg-bg -translate-y-full group-hover:translate-y-0 transition-transform duration-700 ease-[cubic-bezier(0.76,0,0.24,1)] pointer-events-none"></div>
          <div class="relative flex flex-col md:grid md:grid-cols-12 gap-6 md:gap-8 items-start">
            <div class="md:col-span-1">
              <span class="font-mono text-xs text-bg/30 group-hover:text-ink transition-colors duration-500">{service.number}</span>
            </div>
            <div class="md:col-span-4">
              <h3 class="font-sans font-black uppercase tracking-tighter leading-none group-hover:text-ink transition-colors duration-500"
                  style="font-size: clamp(1.8rem, 4vw, 3.5rem)">
                {service.title}
              </h3>
            </div>
            <div class="md:col-span-4">
              <p class="text-xs text-bg/60 group-hover:text-ink/70 leading-relaxed transition-colors duration-500 uppercase tracking-wide">
                {service.description}
              </p>
            </div>
            <div class="md:col-span-3">
              <ul class="space-y-2">
                {service.bullets.map((b: string) => (
                  <li class="flex items-start gap-2 text-xs text-bg/40 group-hover:text-ink/50 transition-colors duration-500 uppercase tracking-wider">
                    <span class="mt-0.5">—</span><span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
