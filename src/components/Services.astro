---
import siteData from '@/data/site.json';
const { services } = siteData;
---

<section id="services" class="relative py-24 md:py-40 bg-ink text-bg overflow-hidden">
  <div class="container-wide relative z-10">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-16 md:mb-24 reveal-up">
      <div>
        <div class="flex items-center gap-3 mb-6">
          <span class="w-8 h-px bg-bg/30"></span>
          <span class="text-xs font-mono uppercase tracking-widest text-bg/50">
            Services — Что я делаю
          </span>
        </div>
        <h2 class="font-sans font-semibold uppercase tracking-tight text-display">
          Три формата,<br/>один результат
        </h2>
      </div>
      <p class="text-xs text-bg/50 max-w-xs font-mono uppercase tracking-widest leading-relaxed">
        — 02 / От одного Reel до полного ведения соцсетей
      </p>
    </div>

    <div class="space-y-0">
      {services.map((service: any) => (
        <div class="group relative border-t border-bg/10 py-8 md:py-10 cursor-pointer overflow-hidden" data-cursor-hover>
          <div class="absolute inset-0 bg-bg -translate-y-full group-hover:translate-y-0 transition-transform duration-700 ease-[cubic-bezier(0.76,0,0.24,1)] pointer-events-none"></div>

          <div class="relative flex flex-col md:grid md:grid-cols-12 gap-6 md:gap-8 items-start">
            <div class="md:col-span-1">
              <span class="font-mono text-xs text-bg/40 group-hover:text-ink transition-colors duration-500">
                {service.number}
              </span>
            </div>
            <div class="md:col-span-4">
              <h3 class="font-sans font-semibold uppercase tracking-widest text-xl md:text-2xl group-hover:text-ink transition-colors duration-500">
                {service.title}
              </h3>
            </div>
            <div class="md:col-span-4">
              <p class="text-sm text-bg/70 group-hover:text-ink/70 leading-relaxed transition-colors duration-500">
                {service.description}
              </p>
            </div>
            <div class="md:col-span-3">
              <ul class="space-y-2">
                {service.bullets.map((b: string) => (
                  <li class="flex items-start gap-2 text-xs text-bg/50 group-hover:text-ink/60 transition-colors duration-500 uppercase tracking-wider">
                    <span class="mt-0.5">—</span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
