---
import siteData from '@/data/site.json';
import MagneticButton from '@/components/MagneticButton.tsx';
const { contact } = siteData;
---

<section id="contact" class="relative py-24 md:py-40 overflow-hidden">
  <div class="container-wide relative z-10">

    {/* Oversized title */}
    <div class="mb-4 md:mb-6 reveal-up overflow-hidden">
      <h2 class="font-sans font-black uppercase leading-none tracking-tighter"
          style="font-size: clamp(2.5rem, 11vw, 11rem)">
        Contact
      </h2>
    </div>

    <p class="text-xs font-mono uppercase tracking-widest text-ink-muted mb-16 md:mb-24 reveal-up max-w-xs" style="transition-delay:0.1s">
      — 03 / {contact.subline}
    </p>

    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-12">
      {/* Big email */}
      <MagneticButton
        href={`mailto:${contact.email}`}
        strength={0.3}
        client:visible
        className="group inline-flex items-center gap-4"
      >
        <span class="font-display italic leading-none tracking-tight hover:opacity-60 transition-opacity duration-500"
              style="font-size: clamp(1.5rem, 4vw, 3.5rem)">
          {contact.email}
        </span>
        <span class="w-12 h-12 md:w-16 md:h-16 rounded-full bg-ink text-bg flex items-center justify-center group-hover:scale-110 transition-transform duration-500 shrink-0">
          <svg width="16" height="16" viewBox="0 0 14 14" fill="none">
            <path d="M3 11L11 3M11 3H4M11 3V10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </span>
      </MagneticButton>

      {/* Socials */}
      <div class="flex flex-col gap-3 shrink-0">
        <a href={`https://t.me/${contact.telegram.replace('@','')}`} target="_blank" rel="noopener"
           class="link-underline text-xs font-mono uppercase tracking-widest text-ink-muted hover:text-ink transition-colors">
          Telegram {contact.telegram}
        </a>
        <a href={`https://instagram.com/${contact.instagram.replace('@','')}`} target="_blank" rel="noopener"
           class="link-underline text-xs font-mono uppercase tracking-widest text-ink-muted hover:text-ink transition-colors">
          Instagram {contact.instagram}
        </a>
        <a href={`https://tiktok.com/${contact.tiktok}`} target="_blank" rel="noopener"
           class="link-underline text-xs font-mono uppercase tracking-widest text-ink-muted hover:text-ink transition-colors">
          TikTok {contact.tiktok}
        </a>
      </div>
    </div>
  </div>
</section>
