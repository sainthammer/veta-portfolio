---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import ScatteredPortfolio from '@/components/ScatteredPortfolio.tsx';

const works = await getCollection('portfolio');
works.sort((a, b) => a.data.order - b.data.order);

// Prepare optimized images for client component
const workItems = await Promise.all(
  works.map(async (w) => {
    const cover = await getImage({
      src: w.data.cover,
      width: 1400,
      quality: 82,
      format: 'webp',
    });

    let gallerySrc: string[] = [];
    if (w.data.gallery && w.data.gallery.length > 0) {
      const optimized = await Promise.all(
        w.data.gallery.map((img: any) =>
          getImage({ src: img, width: 1800, quality: 85, format: 'webp' })
        )
      );
      gallerySrc = optimized.map((o) => o.src);
    }

    return {
      slug: w.slug,
      title: w.data.title,
      client: w.data.client ?? '',
      category: w.data.category,
      year: w.data.year,
      coverSrc: cover.src,
      gallerySrc,
      description: w.data.description,
      tags: w.data.tags,
      order: w.data.order,
    };
  })
);
---

<section id="work" class="relative py-24 md:py-40">
  <div class="container-wide">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-16 md:mb-24 reveal-up">
      <div>
        <div class="flex items-center gap-3 mb-6">
          <span class="w-8 h-px bg-ink"></span>
          <span class="text-xs font-mono uppercase tracking-widest text-ink-muted">
            Selected Work — 2024/25
          </span>
        </div>
        <h2 class="font-display text-display font-light max-w-3xl">
          Проекты, которые<br/>
          <span class="italic">доросли</span> до миллионов
          <span class="text-accent">.</span>
        </h2>
      </div>
      <div class="text-sm text-ink-muted max-w-xs font-mono">
        <div class="uppercase tracking-widest mb-2">— 01</div>
        <p>Небольшая выборка последних работ. Полное портфолио — по запросу.</p>
      </div>
    </div>

    <ScatteredPortfolio works={workItems} client:visible />

    <div class="mt-20 md:mt-32 text-center reveal-up">
      <a href="#contact" class="inline-flex items-center gap-4 group">
        <span class="font-display italic text-3xl md:text-5xl">Хочу такой же</span>
        <span class="w-16 h-16 md:w-20 md:h-20 rounded-full bg-accent text-bg flex items-center justify-center group-hover:scale-110 transition-transform duration-500">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M4 10H16M16 10L10 4M16 10L10 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>
