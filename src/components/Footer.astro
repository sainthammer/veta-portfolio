---
import siteData from '@/data/site.json';
---

<footer class="relative bg-ink text-bg py-12 md:py-16">
  <div class="container-wide">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-8">
      <div>
        <a href="#top" class="font-sans font-black uppercase text-4xl md:text-6xl tracking-tight leading-none">
          Veta<span class="opacity-30">.</span>
        </a>
        <div class="mt-4 text-xs font-mono uppercase tracking-widest text-bg/40">
          {siteData.footer.copyright}
        </div>
      </div>

      <div class="flex flex-col md:flex-row gap-6 md:gap-12 text-xs font-mono uppercase tracking-widest">
        <a href="#work" class="link-underline text-bg/50 hover:text-bg transition-colors">Работы</a>
        <a href="#services" class="link-underline text-bg/50 hover:text-bg transition-colors">Услуги</a>
        <a href="#contact" class="link-underline text-bg/50 hover:text-bg transition-colors">Контакты</a>
        <a href="/admin" class="link-underline text-bg/20 hover:text-bg/60 transition-colors">CMS</a>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-bg/10 flex flex-col md:flex-row justify-between gap-4 text-xs font-mono text-bg/30 uppercase tracking-widest">
      <div>Made with Astro — 2025</div>
      <div>{siteData.hero.location}</div>
    </div>
  </div>
</footer>
