---
import siteData from '@/data/site.json';
---

<header class="fixed top-0 left-0 right-0 z-50 mix-blend-difference">
  <div class="container-wide flex items-center justify-between py-6 md:py-8">
    <a href="#top" class="text-white font-display text-2xl md:text-4xl tracking-tight leading-none">
      Veta<span class="text-accent">.</span>
    </a>

    <nav class="hidden md:flex items-center gap-10 text-white text-sm uppercase tracking-wider font-medium">
      <a href="#work" class="link-underline">Работы</a>
      <a href="#services" class="link-underline">Услуги</a>
      <a href="#contact" class="link-underline">Контакты</a>
    </nav>

    <a href="#contact" class="hidden md:inline-flex items-center gap-2 text-white text-sm uppercase tracking-wider font-medium group">
      <span class="w-2 h-2 rounded-full bg-accent animate-pulse-soft"></span>
      <span>{siteData.hero.availability.split('—')[0].trim()}</span>
    </a>

    <a href="#contact" class="md:hidden text-white text-sm uppercase tracking-wider font-medium">
      Связаться
    </a>
  </div>
</header>
