---
import siteData from '@/data/site.json';
const { services } = siteData;
---

<section id="services" class="relative py-24 md:py-40 bg-ink text-bg overflow-hidden">
  {/* Background accent */}
  <div class="absolute top-0 right-0 w-[500px] h-[500px] rounded-full bg-accent/20 blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="container-wide relative z-10">
    {/* Section header */}
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-16 md:mb-24 reveal-up">
      <div>
        <div class="flex items-center gap-3 mb-6">
          <span class="w-8 h-px bg-bg"></span>
          <span class="text-xs font-mono uppercase tracking-widest text-bg/60">
            Services — Что я делаю
          </span>
        </div>
        <h2 class="font-display text-display font-light max-w-3xl">
          Три формата,<br/>
          один <span class="italic text-accent">результат</span>
        </h2>
      </div>
      <div class="text-sm text-bg/60 max-w-xs font-mono">
        <div class="uppercase tracking-widest mb-2">— 02</div>
        <p>От одного Reel до полного ведения соцсетей — выбирайте нужный пакет.</p>
      </div>
    </div>

    {/* Services list */}
    <div class="space-y-6 md:space-y-8">
      {services.map((service: any, idx: number) => (
        <div
          class="group relative border-t border-bg/15 py-8 md:py-10 cursor-pointer overflow-hidden"
          data-reveal
          data-cursor-hover
        >
          {/* Animated background on hover */}
          <div class="absolute inset-0 bg-accent -translate-y-full group-hover:translate-y-0 transition-transform duration-700 ease-[cubic-bezier(0.76,0,0.24,1)] pointer-events-none"></div>

          <div class="relative flex flex-col md:grid md:grid-cols-12 gap-6 md:gap-8 items-start">
            {/* Number */}
            <div class="md:col-span-1">
              <span class="font-mono text-sm text-bg/60 group-hover:text-ink transition-colors duration-500">
                {service.number}
              </span>
            </div>

            {/* Title */}
            <div class="md:col-span-4">
              <h3 class="font-display text-3xl md:text-5xl font-light leading-none group-hover:italic transition-all duration-500">
                {service.title}
              </h3>
            </div>

            {/* Description */}
            <div class="md:col-span-4">
              <p class="text-bg/80 group-hover:text-ink leading-relaxed transition-colors duration-500">
                {service.description}
              </p>
            </div>

            {/* Bullets */}
            <div class="md:col-span-3">
              <ul class="space-y-2 text-sm text-bg/70 group-hover:text-ink/80 transition-colors duration-500">
                {service.bullets.map((b: string) => (
                  <li class="flex items-start gap-2">
                    <span class="text-accent group-hover:text-ink mt-1">—</span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
