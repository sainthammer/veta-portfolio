---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CustomCursor from '@/components/CustomCursor.tsx';
import LenisProvider from '@/components/LenisProvider.tsx';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Veta Sergeeva — Stories · Reels · SMM',
  description = 'Создаю Reels, Stories и веду соцсети. Контент, который смотрят до конца и пересылают друзьям.',
} = Astro.props;
---

<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://vetasergeeva.ru" />
  <meta property="og:image" content="https://vetasergeeva.ru/og-image.jpg" />
  <meta property="og:locale" content="ru_RU" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://vetasergeeva.ru/og-image.jpg" />

  <!-- Canonical -->
  <link rel="canonical" href="https://vetasergeeva.ru" />

  <meta name="theme-color" content="#F5F3EE" />
  <title>{title}</title>
</head>
  <body class="cursor-active">
    <CustomCursor client:load />
    <LenisProvider client:load />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // Intersection observer for reveal animations
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -80px 0px' }
      );

      document.querySelectorAll('.reveal-up, [data-reveal]').forEach((el) => {
        observer.observe(el);
      });
    </script>
  </body>
</html>
