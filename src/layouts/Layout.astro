---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CustomCursor from '@/components/CustomCursor.tsx';
import LenisProvider from '@/components/LenisProvider.tsx';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Veta Sergeeva — Stories · Reels · SMM',
  description = 'Создаю Reels, Stories и веду соцсети. Контент, который смотрят до конца и пересылают друзьям.',
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#F5F3EE" />
    <title>{title}</title>
  </head>
  <body class="cursor-active">
    <CustomCursor client:load />
    <LenisProvider client:load />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // Intersection observer for reveal animations
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -80px 0px' }
      );

      document.querySelectorAll('.reveal-up, [data-reveal]').forEach((el) => {
        observer.observe(el);
      });
    </script>
  </body>
</html>
