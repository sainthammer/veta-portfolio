# ====================================================================
# Переменные для Docker Compose и Decap CMS OAuth
# ====================================================================
# Скопируйте этот файл в .env и заполните реальными значениями:
#   cp .env.example .env
# ====================================================================

# Домен, на котором будет работать сайт (без https:// и без слэша)
DOMAIN=vetasergeeva.com

# GitHub OAuth App credentials
# Создать здесь: https://github.com/settings/developers -> New OAuth App
#   Homepage URL:               https://YOUR_DOMAIN
#   Authorization callback URL: https://YOUR_DOMAIN/callback
OAUTH_CLIENT_ID=ghp_xxxxxxxxxxxxxxxxxxxx
OAUTH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
